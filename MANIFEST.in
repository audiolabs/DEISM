include README.md
include LICENSE
graft thirdPartyLegalNotices

# Python sources and the native-extension sources needed for an sdist install.
include deism/*.py
include deism/count_reflections.cpp
include deism/libroom_src/*.cpp
include deism/libroom_src/*.hpp

# Only Eigen's headers are needed to build libroom. Exclude its benchmarks,
# tests, documentation, and build system from release artifacts.
prune deism/libroom_src/ext/eigen
recursive-include deism/libroom_src/ext/eigen/Eigen *
include deism/libroom_src/ext/eigen/COPYING.MPL2

# setuptools-scm exposes all tracked files to setuptools' file finder. Keep
# repository-only material out of source distributions.
prune .claude
prune .github
prune benchmarks
prune development
prune docs
prune examples
# Restore the internal deism.examples package after pruning the large example
# tree. Only the sampled directivity subtree is restored below.
include examples/*.py
include examples/configSingleParam*.yml
prune playground
include playground/__init__.py
include playground/demo.html
include playground/native.html
include playground/catalog.json
include playground/LICENSE.txt
prune playground/data
prune playground/results
# The sampled-directivity MAT datasets stay out of the sdist and wheels;
# deism-playground downloads them from the GitHub release on first use.
prune tests
prune tools
prune deism/tests
prune deism/__pycache__
exclude .gitignore
exclude .readthedocs.yml
exclude __init__.py
exclude deism_env.yml
exclude requirements.txt

# Never package editable-build outputs or generated Numba/Python caches.
global-exclude *.so
global-exclude *.dylib
global-exclude *.dll
global-exclude *.pyd
global-exclude *.py[cod]
global-exclude *.nbc
global-exclude *.nbi
global-exclude .DS_Store
